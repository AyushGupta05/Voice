// P33: What does Edit>Undo do inside a headless batch-mode macro?
out = "C:/Users/arnav/Documents/dev/click-to-batch/docs/01-analysis/references/probes/P33-undo-batch.out.txt";
s = "";
setBatchMode(true);
newImage("u1", "8-bit ramp", 64, 64, 1);
v0 = getPixel(40, 10);
run("Invert");
v1 = getPixel(40, 10);
run("Undo");
v2 = getPixel(40, 10);
s = s + "single 8-bit Invert: before=" + v0 + " afterInvert=" + v1 + " afterUndo=" + v2 + "\n";
run("Gaussian Blur...", "sigma=4");
v3 = getPixel(40, 10);
run("Undo");
v4 = getPixel(40, 10);
s = s + "single 8-bit Gaussian: afterBlur=" + v3 + " afterUndo=" + v4 + "\n";
run("Invert");
run("Add...", "value=5");
v5 = getPixel(40, 10);
run("Undo");
v6 = getPixel(40, 10);
run("Undo");
v7 = getPixel(40, 10);
s = s + "two-step Invert then Add 5: after=" + v5 + " afterUndo1=" + v6 + " afterUndo2=" + v7 + "\n";
newImage("u2", "8-bit ramp", 64, 64, 3);
setSlice(2);
w0 = getPixel(40, 10);
run("Invert", "stack");
w1 = getPixel(40, 10);
run("Undo");
w2 = getPixel(40, 10);
s = s + "stack Invert (stack): before=" + w0 + " afterInvert=" + w1 + " afterUndo=" + w2 + "\n";
selectImage("u1");
run("8-bit");
newImage("u3", "16-bit ramp", 64, 64, 1);
setMinAndMax(0, 30000);
x0 = getPixel(40, 10);
run("8-bit");
x1 = getPixel(40, 10);
b1 = bitDepth();
run("Undo");
x2 = getPixel(40, 10);
b2 = bitDepth();
s = s + "16-bit->8-bit conversion: before=" + x0 + " after=" + x1 + " bitDepth=" + b1 + " afterUndo=" + x2 + " bitDepthAfterUndo=" + b2 + "\n";
newImage("u4", "8-bit random", 64, 64, 1);
g0 = getPixel(20, 20);
run("Gaussian Blur...", "sigma=4");
g1 = getPixel(20, 20);
run("Undo");
g2 = getPixel(20, 20);
s = s + "random 8-bit Gaussian sigma=4: before=" + g0 + " afterBlur=" + g1 + " afterUndo=" + g2 + "\n";
File.saveString(s, out);
eval("script", "System.exit(0);");
