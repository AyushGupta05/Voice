{"id": "j12-03", "text": "Threshold using Otsu with dark background.", "state": "uncal", "expect": {"status": "READY", "steps": [{"kind": "DIRECT", "operation": "SET_AUTO_THRESHOLD", "params": {"method": "Otsu", "dark": true}, "macro": "setAutoThreshold(\"Otsu dark\");"}]}, "origin": "NL_SPOKEN", "tags": ["j12"]}
{"id": "j12-04", "text": "Convert to mask with black background.", "state": "uncal", "expect": {"status": "READY", "steps": [{"kind": "COMMAND", "commandId": "ij1:Process>Binary>Convert to Mask", "macroExact": "run(\"Convert to Mask\");", "params": {"black": true}, "macro": "setOption(\"BlackBackground\", true)"}]}, "origin": "NL_SPOKEN", "tags": ["j12"]}
{"id": "j12-05", "text": "Watershed.", "state": "uncal", "expect": {"status": "READY", "steps": [{"kind": "COMMAND", "commandId": "ij1:Process>Binary>Watershed", "macroExact": "run(\"Watershed\");"}]}, "origin": "NL_SPOKEN", "tags": ["j12"]}
{"id": "j12-06", "text": "Set measurements area mean min and integrated density.", "state": "uncal", "expect": {"status": "READY", "steps": [{"kind": "COMMAND", "commandId": "ij1:Analyze>Set Measurements...", "macroExact": "run(\"Set Measurements...\", \"area mean min integrated redirect=None decimal=9\");", "params": {"area": true, "mean": true, "min": true, "integrated": true, "standard": false, "redirect": "None", "decimal": 9}}]}, "origin": "NL_SPOKEN", "tags": ["j12"]}
{"id": "j12-07", "text": "Measure.", "state": "uncal", "expect": {"status": "READY", "steps": [{"kind": "COMMAND", "commandId": "ij1:Analyze>Measure", "macroExact": "run(\"Measure\");"}]}, "origin": "NL_SPOKEN", "tags": ["j12"]}
{"id": "j12-08", "text": "Analyze particles larger than twenty pixels showing masks and adding to the manager.", "state": "uncal", "expect": {"status": "READY", "steps": [{"kind": "COMMAND", "commandId": "ij1:Analyze>Analyze Particles...", "macroExact": "run(\"Analyze Particles...\", \"size=20-Infinity show=Masks display clear include summarize add\");", "params": {"size": "20-Infinity", "show": "Masks", "display": true, "clear": true, "include": true, "summarize": true, "add": true, "exclude": false}}]}, "origin": "NL_SPOKEN", "tags": ["j12"]}
{"id": "j12-09", "text": "Invert the image.", "state": "uncal", "expect": {"status": "READY", "steps": [{"kind": "COMMAND", "commandId": "ij1:Edit>Invert", "macroExact": "run(\"Invert\");"}]}, "origin": "NL_SPOKEN", "tags": ["j12"]}
{"id": "j12-10", "text": "Undo.", "state": "uncal", "expect": {"status": "READY", "steps": [{"kind": "DIRECT", "operation": "UNDO", "macro": "run(\"Undo\");"}]}, "origin": "NL_SPOKEN", "tags": ["j12"]}
{"id": "j12p-01", "text": "apply a rolling ball background subtraction with radius fifty pixels", "state": "uncal", "expect": {"status": "READY", "steps": [{"kind": "COMMAND", "commandId": "ij1:Process>Subtract Background...", "macroExact": "run(\"Subtract Background...\", \"rolling=50\");", "params": {"rolling": 50}}]}, "tags": ["j12", "paraphrase"]}
{"id": "j12p-02", "text": "blur the image with a gaussian of sigma 2 pixels", "state": "uncal", "expect": {"status": "READY", "steps": [{"kind": "COMMAND", "commandId": "ij1:Process>Filters>Gaussian Blur...", "macroExact": "run(\"Gaussian Blur...\", \"sigma=2\");", "params": {"sigma": 2}}]}, "tags": ["j12", "paraphrase"]}
{"id": "j12p-03", "text": "otsu threshold, dark background", "state": "uncal", "expect": {"status": "READY", "steps": [{"kind": "DIRECT", "operation": "SET_AUTO_THRESHOLD", "params": {"method": "Otsu", "dark": true}}]}, "tags": ["j12", "paraphrase"]}
{"id": "j12p-04", "text": "make a mask with a black background", "state": "uncal", "expect": {"status": "READY", "steps": [{"kind": "COMMAND", "commandId": "ij1:Process>Binary>Convert to Mask", "macroExact": "run(\"Convert to Mask\");", "params": {"black": true}}]}, "tags": ["j12", "paraphrase"]}
{"id": "j12p-05", "text": "run the watershed", "state": "uncal", "expect": {"status": "READY", "steps": [{"kind": "COMMAND", "commandId": "ij1:Process>Binary>Watershed", "macroExact": "run(\"Watershed\");"}]}, "tags": ["j12", "paraphrase"]}
{"id": "j12p-06", "text": "set the measurements to area, mean, min and integrated density", "state": "uncal", "expect": {"status": "READY", "steps": [{"kind": "COMMAND", "commandId": "ij1:Analyze>Set Measurements...", "params": {"area": true, "mean": true, "min": true, "integrated": true, "perimeter": false, "decimal": 9}}]}, "tags": ["j12", "paraphrase"]}
{"id": "j12p-07", "text": "please measure it", "state": "uncal", "expect": {"status": "READY", "steps": [{"kind": "COMMAND", "commandId": "ij1:Analyze>Measure", "macroExact": "run(\"Measure\");"}]}, "tags": ["j12", "paraphrase"]}
{"id": "j12p-08", "text": "analyse particles bigger than twenty pixels, show masks and add them to the manager", "state": "uncal", "expect": {"status": "READY", "steps": [{"kind": "COMMAND", "commandId": "ij1:Analyze>Analyze Particles...", "macroExact": "run(\"Analyze Particles...\", \"size=20-Infinity show=Masks display clear include summarize add\");", "params": {"size": "20-Infinity", "show": "Masks", "add": true, "display": true, "clear": true, "include": true, "summarize": true}}]}, "tags": ["j12", "paraphrase"]}
{"id": "j12p-09", "text": "please invert it", "state": "uncal", "expect": {"status": "READY", "steps": [{"kind": "COMMAND", "commandId": "ij1:Edit>Invert"}]}, "tags": ["j12", "paraphrase"]}
{"id": "j12p-10", "text": "undo the last action", "state": "uncal", "expect": {"status": "READY", "steps": [{"kind": "DIRECT", "operation": "UNDO"}]}, "tags": ["j12", "paraphrase"]}
{"id": "j12-seq", "text": "Subtract background with a rolling ball radius of fifty then gaussian blur with sigma two pixels then threshold using Otsu with dark background then convert to mask with black background then watershed", "state": "uncal", "expect": {"status": "READY", "steps": [{"kind": "COMMAND", "commandId": "ij1:Process>Subtract Background..."}, {"kind": "COMMAND", "commandId": "ij1:Process>Filters>Gaussian Blur..."}, {"kind": "DIRECT", "operation": "SET_AUTO_THRESHOLD"}, {"kind": "COMMAND", "commandId": "ij1:Process>Binary>Convert to Mask"}, {"kind": "COMMAND", "commandId": "ij1:Process>Binary>Watershed"}]}, "origin": "NL_SPOKEN", "tags": ["j12", "sequence"]}
{"id": "ref-01", "text": "delete my files", "state": "uncal", "expect": {"status": "REFUSED", "refusal": "never"}, "tags": ["out-of-scope"]}
